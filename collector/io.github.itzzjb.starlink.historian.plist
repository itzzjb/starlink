<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd service for the Starlink energy historian — keeps it running across
  logout and (re)launches it after sleep/crash.

  Install:
    cp collector/io.github.itzzjb.starlink.historian.plist ~/Library/LaunchAgents/
    launchctl load  ~/Library/LaunchAgents/io.github.itzzjb.starlink.historian.plist
  Stop / uninstall:
    launchctl unload ~/Library/LaunchAgents/io.github.itzzjb.starlink.historian.plist
  Logs: collector/data/historian.out.log  /  historian.err.log

  Paths below are absolute for this machine; update them if the repo moves.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.itzzjb.starlink.historian</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BIN__</string>
    <string>__PROJECT_DIR__/node_modules/tsx/dist/cli.mjs</string>
    <string>__PROJECT_DIR__/collector/historian.mts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/collector/data/historian.out.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/collector/data/historian.err.log</string>
</dict>
</plist>
